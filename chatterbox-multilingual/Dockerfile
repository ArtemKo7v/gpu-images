# Official PyTorch 2.6.0 CUDA 12.4 runtime image, pinned by digest.
FROM pytorch/pytorch@sha256:77f17f843507062875ce8be2a6f76aa6aa3df7f9ef1e31d9d7432f4b0f563dee
USER root
ARG CHATTERBOX_COMMIT=5de7a54aa4e5e2baadb0182dde554908b48b85c2
LABEL org.opencontainers.image.source="https://github.com/ArtemKo7v/gpu-images" \
    org.opencontainers.image.title="chatterbox-multilingual" \
    org.opencontainers.image.description="Chatterbox Multilingual V3 TTS on PyTorch CUDA, HTTP on 127.0.0.1:8011" \
    org.opencontainers.image.version="$CHATTERBOX_COMMIT"
# Host keys generated by the package install would be shared by every container
# and published in the image; they are removed and created at start (ssh-keygen -A).
# python3 is linked into /usr/local/bin for on-start scripts without /opt/conda/bin in PATH.
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server util-linux curl && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/ssh/ssh_host_* \
    && useradd --create-home --shell /bin/bash worker \
    && mkdir -p /opt/chatterbox/models /opt/chatterbox/pkuseg /home/worker/voices \
    && chown worker:worker /home/worker/voices \
    && ln -s "$(command -v python3)" /usr/local/bin/python3
# A random unknown password unlocks the account for public-key SSH even with UsePAM=no.
RUN python3 -c 'import secrets,subprocess; subprocess.run(["chpasswd"], input="worker:"+secrets.token_urlsafe(48)+"\n", text=True, check=True)'
COPY requirements.txt /opt/chatterbox/
RUN pip install --no-cache-dir -r /opt/chatterbox/requirements.txt \
    && pip install --no-cache-dir --no-deps \
       "https://github.com/resemble-ai/chatterbox/archive/${CHATTERBOX_COMMIT}.tar.gz"
COPY licenses/ /opt/chatterbox/licenses/
COPY NOTICE model.json fetch_models.py server.py start.py /opt/chatterbox/
ENV PKUSEG_HOME=/opt/chatterbox/pkuseg HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
WORKDIR /opt/chatterbox
# Weights are downloaded once at build time and verified by size and SHA-256.
RUN python3 fetch_models.py --manifest model.json --model-dir models --pkuseg-home pkuseg
# Import check; needs no GPU and does not load the model.
RUN python3 -c "import chatterbox.mtl_tts, server"
EXPOSE 22
HEALTHCHECK --interval=10s --timeout=3s --start-period=180s \
    CMD curl --fail --silent http://127.0.0.1:8011/health || exit 1
ENTRYPOINT ["python3", "/opt/chatterbox/start.py"]
